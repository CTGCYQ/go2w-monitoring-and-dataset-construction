[Unit]
Description=Robot LAN time server (host clock read-only)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=dell
RuntimeDirectory=go2w-time
ExecStart=/home/dell/go2w_gaussian/ntp/usr/sbin/chronyd -x -U -d -u dell -f /home/dell/go2w_gaussian/ntp-server.conf
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/go2w-time /home/dell/go2w_gaussian/logs
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
